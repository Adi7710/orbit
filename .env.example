# Copy to .env.local. Never commit real keys.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_TOOL_SECRET=
# NVIDIA hosted Nemotron (build.nvidia.com). No local models.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional overrides; otherwise Orbit picks the first available id from /v1/models
NEMOTRON_MODEL=
NEMOTRON_PARSE_MODEL=
# Postgres (Supabase, Neon, or Tiger Cloud). Leave empty to run in-memory for demos.
DATABASE_URL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Pittsburgh Regional Transit. Static schedule is in data/prt-oakland.json (regenerate: node scripts/gtfs-extract.mjs).
# Realtime trip updates are public; set DEMO_MODE=offline to skip the live fetch.
PRT_GTFS_RT_URL=https://truetime.portauthority.org/gtfsrt-bus/trips
DEMO_MODE=live
# ESCAPE HATCH, LEAVE UNSET. Pins the planning clock to a fixed weekday and DISABLES live buses,
# because a simulated time cannot be matched against a live feed. Only set this if PRT's realtime
# feed is down at demo time and you need a timetable-only fallback. The UI labels it loudly.
# DEMO_CLOCK=2026-09-22T13:10

# The name Orbit greets you by, on the page and in the opening briefing.
# Defaults to Adi.
ORBIT_USER_NAME=

# Which city Orbit plans in.
#   hudson  (default) Jersey City / Hoboken: Hudson-Bergen Light Rail + PATH, Stevens
#   oakland           Pittsburgh: PRT around Pitt
ORBIT_REGION=

# PATH live departure board. Public, no key; override only to point at a mirror.
PATH_RIDEPATH_URL=

# Which ElevenLabs voice Orbit speaks in. Leave blank for the configured
# default (George, warm storyteller). Find ids with: GET /v1/voices
ELEVENLABS_VOICE_ID=

# Real walking routes from Google Routes: actual paths, stairs and elevation.
# Without it every walk is straight-line distance x 1.3 at a fixed pace, which
# is badly wrong for the climb from Hoboken Terminal up to Stevens on Castle
# Point. Enable "Routes API" on the key. Walking is not traffic-affected, so
# this buys accuracy, not live conditions.
GOOGLE_MAPS_API_KEY=
