# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/GTFS.zip
data/gtfs-extracted/

# local tunnel
.tunnel.log
.tunnel-url.txt

# Xcode
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
.swiftpm/

# Claude Code skill packs pulled from third-party repos. Not our code, not a library:
# kept out of the tree so nothing written before 11:00 on 19 Sept is in it.
.agents/
.claude/
skills-lock.json

# The example env has no secrets and is the one .env* file that belongs in git.
!.env.example
